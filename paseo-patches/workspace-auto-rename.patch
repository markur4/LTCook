+function WorkspaceAutoRename({
+  surface,
+  serverId,
+  workspaceId,
+  workspaceKey,
+}: {
+  surface: MenuSurface;
+  serverId: string;
+  workspaceId: string;
+  workspaceKey: string;
+}) {
+  const enabled = useWorkspaceFields(serverId, workspaceId, (workspace) => workspace.ltcookAutoRename);
+  const client = useHostRuntimeClient(serverId);
+  const toast = useToast();
+  const [saving, setSaving] = useState(false);
+  if (typeof enabled !== "boolean") return null;
+  const Toggle = enabled ? ThemedToggleRight : ThemedToggleLeft;
+  async function toggle() {
+    if (!client || saving) return;
+    setSaving(true);
+    try {
+      await client.setWorkspaceMetadata(workspaceId, { "ltcook.autoRename": !enabled });
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : "Could not update Auto-rename");
+    } finally {
+      setSaving(false);
+    }
+  }
+  return (
+    <WorkspaceMenuItem
+      surface={surface}
+      selected={enabled}
+      disabled={saving || !client}
+      closeOnSelect={false}
+      onSelect={() => void toggle()}
+      trailing={<Toggle size={20} uniProps={foregroundColorMapping} />}
+      testID={`sidebar-workspace-menu-auto-rename-${workspaceKey}`}
+    >
+      Auto-rename
+    </WorkspaceMenuItem>
+  );
+}
