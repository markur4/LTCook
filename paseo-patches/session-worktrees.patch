diff --git a/packages/app/src/panels/changes/session-worktree-target.test.ts b/packages/app/src/panels/changes/session-worktree-target.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/app/src/panels/changes/session-worktree-target.test.ts
@@ -0,0 +1,36 @@
+import { expect, it } from "vitest";
+import {
+  resolveSessionWorktree,
+  type SessionWorktreeSnapshot,
+} from "./session-worktree-target";
+
+const first = { path: "/projects/first", branch: "feature/first" };
+const second = { path: "/projects/second", branch: "feature/second" };
+const snapshot: SessionWorktreeSnapshot = {
+  agentId: "agent-one",
+  sessionId: "session-one",
+  original: "/projects/main",
+  following: first,
+  available: [first, second],
+};
+
+it("follows the session by default and uses the original checkout after removal", () => {
+  expect(resolveSessionWorktree(snapshot, undefined)).toBe(first.path);
+  expect(
+    resolveSessionWorktree(
+      { ...snapshot, following: null, available: [second] },
+      undefined
+    )
+  ).toBe(snapshot.original);
+});
+
+it("pins an existing checkout across follow updates and resumes following when unpinned or removed", () => {
+  expect(resolveSessionWorktree(snapshot, snapshot.original)).toBe(
+    snapshot.original
+  );
+  expect(resolveSessionWorktree(snapshot, second.path)).toBe(second.path);
+  expect(resolveSessionWorktree(snapshot, undefined)).toBe(first.path);
+  expect(
+    resolveSessionWorktree({ ...snapshot, available: [first] }, second.path)
+  ).toBe(first.path);
+});
diff --git a/packages/app/src/panels/changes/session-worktree-target.ts b/packages/app/src/panels/changes/session-worktree-target.ts
new file mode 100644
--- /dev/null
+++ b/packages/app/src/panels/changes/session-worktree-target.ts
@@ -0,0 +1,30 @@
+import { z } from "zod";
+
+const worktree = z.object({
+  path: z.string().min(1),
+  branch: z.string().optional(),
+});
+
+export const sessionWorktreeSnapshot = z.object({
+  agentId: z.string().min(1),
+  sessionId: z.string().min(1),
+  original: z.string().min(1),
+  following: worktree.nullable(),
+  available: z.array(worktree),
+});
+
+export type SessionWorktreeSnapshot = z.infer<typeof sessionWorktreeSnapshot>;
+
+export function resolveSessionWorktree(
+  snapshot: SessionWorktreeSnapshot,
+  pinned: string | undefined
+): string {
+  if (
+    pinned &&
+    (pinned === snapshot.original ||
+      snapshot.available.some(({ path }) => path === pinned))
+  ) {
+    return pinned;
+  }
+  return snapshot.following?.path ?? snapshot.original;
+}
diff --git a/packages/app/src/panels/changes/session-worktree.tsx b/packages/app/src/panels/changes/session-worktree.tsx
new file mode 100644
--- /dev/null
+++ b/packages/app/src/panels/changes/session-worktree.tsx
@@ -0,0 +1,175 @@
+import { useEffect, useMemo, useState } from "react";
+import { create } from "zustand";
+import { SelectField } from "@/components/ui/select-field";
+import { resolveFocusedChatTarget } from "@/composer/focused-chat-target";
+import { useInstalledPlugin } from "@/plugins/registry";
+import {
+  collectAllTabs,
+  useWorkspaceLayoutStore,
+} from "@/stores/workspace-layout-store";
+import { buildWorkspaceTabPersistenceKey } from "@/workspace-tabs/model";
+import {
+  resolveSessionWorktree,
+  sessionWorktreeSnapshot,
+  type SessionWorktreeSnapshot,
+} from "./session-worktree-target";
+
+type WorktreePins = {
+  bySession: ReadonlyMap<string, string>;
+  setPin(session: string, path: string | undefined): void;
+};
+
+const useWorktreePins = create<WorktreePins>((set) => ({
+  bySession: new Map(),
+  setPin(session, path) {
+    set(({ bySession }) => {
+      const pins = new Map(bySession);
+      if (path === undefined) pins.delete(session);
+      else pins.set(session, path);
+      return { bySession: pins };
+    });
+  },
+}));
+
+export function useSessionWorktree(
+  serverId: string,
+  workspaceId: string,
+  workspaceDirectory: string | null,
+  enabled: boolean
+) {
+  const workspaceKey = buildWorkspaceTabPersistenceKey({
+    serverId,
+    workspaceId,
+  });
+  const layout = useWorkspaceLayoutStore((state) =>
+    workspaceKey ? state.layoutByWorkspace[workspaceKey] : undefined
+  );
+  const agentId = useMemo(() => {
+    if (!layout) return null;
+    const chat = resolveFocusedChatTarget({ serverId, layout });
+    const tab = collectAllTabs(layout.root).find(
+      ({ tabId }) => tabId === chat?.tabId
+    );
+    return tab?.target.kind === "agent" ? tab.target.agentId : null;
+  }, [layout, serverId]);
+  const plugin = useInstalledPlugin(serverId, "ltcook");
+  const [received, setReceived] = useState<{
+    plugin: typeof plugin;
+    snapshot: SessionWorktreeSnapshot;
+  }>();
+  useEffect(() => {
+    if (!enabled || !plugin || !agentId) return;
+    let active = true;
+    const closed = () => {
+      if (active) setReceived(undefined);
+    };
+    const subscription = plugin.subscribe(
+      "ltcook.session.worktrees",
+      { agentId },
+      {
+        event(input: unknown) {
+          const parsed = sessionWorktreeSnapshot.safeParse(input);
+          if (active && parsed.success && parsed.data.agentId === agentId) {
+            setReceived({ plugin, snapshot: parsed.data });
+          }
+        },
+        closed,
+      }
+    );
+    void subscription.ready.catch(closed);
+    return () => {
+      active = false;
+      subscription();
+    };
+  }, [enabled, plugin, agentId]);
+  const snapshot =
+    received &&
+    received.plugin === plugin &&
+    received.snapshot.agentId === agentId
+      ? received.snapshot
+      : undefined;
+  const sessionKey = snapshot
+    ? JSON.stringify([serverId, snapshot.sessionId])
+    : undefined;
+  const pinned = useWorktreePins(
+    (state) => sessionKey && state.bySession.get(sessionKey)
+  );
+  const setPin = useWorktreePins((state) => state.setPin);
+  const validPin =
+    pinned &&
+    snapshot &&
+    (pinned === snapshot.original ||
+      snapshot.available.some(({ path }) => path === pinned))
+      ? pinned
+      : undefined;
+  useEffect(() => {
+    if (sessionKey && pinned && !validPin) setPin(sessionKey, undefined);
+  }, [pinned, sessionKey, setPin, validPin]);
+
+  const target = snapshot && resolveSessionWorktree(snapshot, validPin);
+  const reviewingWorktree = Boolean(target && target !== snapshot?.original);
+  const picker =
+    snapshot &&
+    sessionKey &&
+    snapshot.available.some(({ path }) => path !== snapshot.original) ? (
+      <SessionWorktreePicker
+        snapshot={snapshot}
+        pinned={validPin}
+        onPin={(path) => setPin(sessionKey, path)}
+      />
+    ) : null;
+  return {
+    cwd: reviewingWorktree ? target ?? workspaceDirectory : workspaceDirectory,
+    reviewingWorktree,
+    picker,
+  };
+}
+
+function SessionWorktreePicker({
+  snapshot,
+  pinned,
+  onPin,
+}: {
+  snapshot: SessionWorktreeSnapshot;
+  pinned?: string;
+  onPin(path: string | undefined): void;
+}) {
+  const options = [
+    { id: "follow", value: "", label: "Follow session" },
+    {
+      id: "original",
+      value: snapshot.original,
+      label: "Original checkout",
+      description: snapshot.original,
+    },
+    ...snapshot.available
+      .filter(({ path }) => path !== snapshot.original)
+      .map(({ path, branch }) => ({
+        id: path,
+        value: path,
+        label: branch || path.split(/[\\/]/).at(-1) || path,
+        description: path,
+      })),
+  ];
+  const value = pinned ?? "";
+  const display = pinned
+    ? options.find((option) => option.value === pinned) ?? null
+    : {
+        label: snapshot.following?.branch ?? "Follow session",
+        description: snapshot.following ? "Following session" : "Original checkout",
+      };
+  return (
+    <SelectField
+      label="Worktree"
+      value={value}
+      selectedDisplay={display}
+      options={options}
+      onChange={(next) => onPin(next || undefined)}
+      placeholder="Worktree"
+      emptyText="No linked worktrees"
+      field={false}
+      size="sm"
+      triggerTestID="changes-worktree-picker"
+    />
+  );
+}
