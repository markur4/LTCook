diff --git a/packages/app/src/agent-stream/timeline-reveal.ts b/packages/app/src/agent-stream/timeline-reveal.ts
new file mode 100644
--- /dev/null
+++ b/packages/app/src/agent-stream/timeline-reveal.ts
@@ -0,0 +1,224 @@
+import { useEffect, useMemo, type RefObject } from "react";
+import { create } from "zustand";
+import type {
+  PluginRevealTimelineItemInput,
+  PluginTimelineNavigationTarget,
+} from "@getpaseo/plugin/client";
+import { useStableEvent } from "@/hooks/use-stable-event";
+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+import { planTimelinePromptJump } from "@/timeline/timeline-sync-plan";
+import { isAgentToolCallItem, type StreamItem } from "@/types/stream";
+import { navigateToAgent } from "@/utils/navigate-to-agent";
+import type { StreamViewportHandle } from "./strategy";
+
+type Destination = PluginRevealTimelineItemInput & { serverId: string };
+
+interface RevealRequest extends Destination {
+  finish(error?: Error): void;
+}
+
+const useRevealRequest = create<{ pending: RevealRequest | null }>(() => ({ pending: null }));
+const REVEAL_TIMEOUT_MS = 15_000;
+
+export function requestTimelineReveal(input: Destination): Promise<void> {
+  const { serverId, agentId, target } = input;
+  if (
+    !serverId.trim() ||
+    !agentId.trim() ||
+    !target.epoch.trim() ||
+    !target.id.trim() ||
+    !Number.isSafeInteger(target.position) ||
+    target.position < 0 ||
+    !Number.isSafeInteger(
+      planTimelinePromptJump({ epoch: target.epoch, seq: target.position }).cursor.seq,
+    ) ||
+    !Number.isFinite(target.at) ||
+    (target.kind !== "message" && target.kind !== "tool")
+  ) {
+    return Promise.reject(new Error("Invalid chat timeline target."));
+  }
+  if (!getHostRuntimeStore().getClient(serverId)) {
+    return Promise.reject(new Error("The requested chat host is unavailable."));
+  }
+
+  useRevealRequest.getState().pending?.finish(new Error("Superseded by another chat reveal."));
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(
+      () => request.finish(new Error("Could not reveal the exact timeline item in chat.")),
+      REVEAL_TIMEOUT_MS,
+    );
+    const request: RevealRequest = {
+      serverId,
+      agentId,
+      target: { ...target },
+      finish(error) {
+        if (useRevealRequest.getState().pending !== request) return;
+        clearTimeout(timer);
+        useRevealRequest.setState({ pending: null });
+        if (error) reject(error);
+        else resolve();
+      },
+    };
+    useRevealRequest.setState({ pending: request });
+    try {
+      navigateToAgent({ serverId, agentId });
+    } catch (error) {
+      request.finish(error instanceof Error ? error : new Error(String(error)));
+    }
+  });
+}
+
+function matchesTimelineReveal(item: StreamItem, target: PluginTimelineNavigationTarget) {
+  if (
+    item.timelineCursor?.epoch !== target.epoch ||
+    item.timelineCursor.seq !== target.position ||
+    (target.turnId !== undefined && item.turnId !== target.turnId)
+  ) {
+    return false;
+  }
+  if (target.kind === "tool") {
+    return isAgentToolCallItem(item) && item.payload.data.callId === target.id;
+  }
+  return (
+    ((item.kind === "user_message" || item.kind === "assistant_message") &&
+      item.messageId === target.id) ||
+    (item.kind === "user_message" && item.clientMessageId === target.id)
+  );
+}
+
+interface RevealChatInput {
+  active: boolean;
+  serverId: string;
+  agentId: string;
+  epoch: string | null;
+  tail: readonly StreamItem[];
+  head: readonly StreamItem[];
+}
+
+export function useTimelineRevealTarget({
+  active,
+  serverId,
+  agentId,
+  epoch,
+  tail,
+  head,
+}: RevealChatInput) {
+  const request = useRevealRequest((state) => {
+    const pending = state.pending;
+    return active && pending?.serverId === serverId && pending.agentId === agentId
+      ? pending
+      : null;
+  });
+  const target = request?.target;
+  const item = useMemo(() => {
+    if (!target || target.epoch !== epoch) return undefined;
+    const matches = (row: StreamItem) => matchesTimelineReveal(row, target);
+    return tail.find(matches) ?? head.find(matches);
+  }, [epoch, head, tail, target]);
+  return { request, item };
+}
+
+interface RevealViewportInput {
+  request: RevealRequest | null;
+  item: StreamItem | undefined;
+  epoch: string | null;
+  viewportRef: RefObject<StreamViewportHandle | null>;
+  mountedMessageIds: { has(messageId: string): boolean };
+  revealLoadedMessage(messageId: string): boolean;
+}
+
+export function useRevealTimelineItem({
+  request,
+  item,
+  epoch,
+  viewportRef,
+  mountedMessageIds,
+  revealLoadedMessage,
+}: RevealViewportInput) {
+  const getViewport = useStableEvent(() => ({
+    epoch,
+    item,
+    viewport: viewportRef.current,
+    mountedMessageIds,
+    revealLoadedMessage,
+  }));
+
+  useEffect(() => {
+    if (!request) return;
+    let active = true;
+    let frame = 0;
+    let fetched = false;
+    let scrollingTo: string | null = null;
+    const tick = () => {
+      if (!active || useRevealRequest.getState().pending !== request) return;
+      const current = getViewport();
+      if (current.epoch !== null && current.epoch !== request.target.epoch) {
+        request.finish(new Error("Chat history changed. This timeline item is no longer available."));
+        return;
+      }
+      if (current.item && current.viewport?.scrollToMessage && current.viewport.isMessageVisible) {
+        const messageId = current.item.id;
+        if (!current.mountedMessageIds.has(messageId)) {
+          current.revealLoadedMessage(messageId);
+        } else if (scrollingTo !== messageId) {
+          current.viewport.scrollToMessage(messageId);
+          scrollingTo = messageId;
+        } else if (current.viewport.isMessageVisible(messageId)) {
+          current.viewport.focus?.();
+          request.finish();
+          return;
+        }
+      } else if (!current.item && !fetched && current.epoch !== null) {
+        fetched = true;
+        void getHostRuntimeStore()
+          .fetchAgentTimeline(
+            request.serverId,
+            request.agentId,
+            planTimelinePromptJump({ epoch: request.target.epoch, seq: request.target.position }),
+          )
+          .then((page) => {
+            if (!active) return;
+            if (page.reset || page.staleCursor || page.epoch !== request.target.epoch) {
+              request.finish(new Error("Chat history changed. This timeline item is no longer available."));
+              return;
+            }
+            if (
+              !page.entries.some((entry) => {
+                const { item, seqEnd, turnId } = entry;
+                const target = request.target;
+                if (
+                  seqEnd !== target.position ||
+                  (target.turnId !== undefined && turnId !== target.turnId)
+                ) {
+                  return false;
+                }
+                if (target.kind === "tool") {
+                  return item.type === "tool_call" && item.callId === target.id;
+                }
+                return (
+                  ((item.type === "user_message" || item.type === "assistant_message") &&
+                    item.messageId === target.id) ||
+                  (item.type === "user_message" && item.clientMessageId === target.id)
+                );
+              })
+            ) {
+              request.finish(new Error("This item is no longer available in the agent's chat history."));
+              return;
+            }
+            frame = requestAnimationFrame(tick);
+          })
+          .catch((error: unknown) => {
+            if (!active) return;
+            request.finish(error instanceof Error ? error : new Error(String(error)));
+          });
+        return;
+      }
+      frame = requestAnimationFrame(tick);
+    };
+    frame = requestAnimationFrame(tick);
+    return () => {
+      active = false;
+      cancelAnimationFrame(frame);
+    };
+  }, [getViewport, request]);
+}
