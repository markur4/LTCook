include uv.lock
include pylock.toml
include app-install.sh app-install.cmd
include app-launch.sh app-launch.cmd
include app-uninstall.sh app-uninstall.cmd

include package.json package-lock.json .node-version
recursive-include runtime/dist *
recursive-include teams/default/dist *
recursive-include teams/default/resources *
recursive-include teams/default-minimal/dist *
recursive-include teams/default-minimal/resources *
recursive-include services *
recursive-include src *

prune INPUT
prune OUTPUT
prune .venv
prune venv
prune build
prune dist
prune logs
prune .agent-sessions
prune AGENT_SESSIONS
prune .git
prune .pytest_cache
prune .ruff_cache
prune __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.log
recursive-exclude tests *
recursive-exclude assets *
