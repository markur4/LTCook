include uv.lock
include pylock.toml
include package.json package-lock.json .node-version
recursive-include src *.py *.pyi py.typed *.env
include src/ltcook_distr/bundle.zip
prune INPUT
prune OUTPUT
prune .venv
prune venv
prune build
prune dist
prune logs
prune .agent-sessions
prune AGENT_SESSIONS
prune .git
prune .pytest_cache
prune .ruff_cache
prune __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.log
recursive-exclude tests *
recursive-exclude evals *
recursive-exclude assets *
