set working-directory := ".."

[group('Agent Evals')]
probe:
    uv run --locked ltcook eval run --quick

[group('Agent Evals')]
audit-static:
    uv run --locked ltcook eval audit --static-only

[group('Agent Evals')]
audit:
    uv run --locked ltcook eval audit

[group('Agent Evals')]
behavior:
    uv run --locked ltcook eval run --behavior-only

[group('Agent Evals')]
bottlenecks:
    uv run --locked ltcook eval analyze

[group('Agent Evals')]
all:
    uv run --locked ltcook eval run --all
